ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# SQLite for local dev, PostgreSQL in production/docker (real row-level locking needs Postgres)
DATABASE_URL=sqlite:///./wallet.db
# DATABASE_URL=postgresql+psycopg2://wallet:wallet@db:5432/wallet

# Optional locally; required in production for shared rate limiting / idempotency cache
REDIS_URL=redis://redis:6379/0

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

DEFAULT_MAX_TRANSACTION_AMOUNT=10000
DEFAULT_DAILY_TRANSFER_LIMIT=20000
DEFAULT_DAILY_WITHDRAWAL_LIMIT=10000
